{
  "name": "yfcli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "YFCLI — 易飞(E10/YF) 产品线 AI 助手（对标 YZCLI 易助产品线）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen:typekey": "node scripts/extract-typekey-map.mjs",
    "gen:fields": "node scripts/extract-field-metadata.mjs",
    "gen:domain": "node scripts/gen-domain-map.mjs",
    "gen:all": "npm run gen:typekey && npm run gen:fields && npm run gen:domain && npm run gen:dictionary && npm run gen:enums",
    "gen:dictionary": "python scripts/gen_data_dictionary.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:domain": "node scripts/gen-domain-map.mjs --check",
    "check:dictionary": "python scripts/gen_data_dictionary.py --verify-stats",
    "check:all": "npm run check:domain && npm run check:dictionary",
    "check": "npm run check:all",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "scan:secrets:staged": "node scripts/scan-secrets.mjs --staged",
    "verify": "npm run scan:secrets && npm run check:all",
    "gen:enums": "python scripts/gen_enums_from_oapmb.py"
  },
  "workspaces": [
    "packages/*"
  ]
}
