{
  "name": "yfcli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "YFCLI — 易飞(E10/YF) 产品线 AI 助手（对标 YZCLI 易助产品线）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen:typekey": "node scripts/extract-typekey-map.mjs",
    "gen:fields": "node scripts/extract-field-metadata.mjs",
    "gen:domain": "node scripts/gen-domain-map.mjs",
    "gen:all": "npm run gen:typekey && npm run gen:fields && npm run gen:domain",
    "check:typekey": "node scripts/extract-typekey-map.mjs --check",
    "check:fields": "node scripts/extract-field-metadata.mjs --check",
    "check:domain": "node scripts/gen-domain-map.mjs --check",
    "check:all": "npm run check:typekey && npm run check:fields && npm run check:domain",
    "check": "npm run check:all",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "scan:secrets:staged": "node scripts/scan-secrets.mjs --staged",
    "verify": "npm run scan:secrets && npm run check:all"
  },
  "workspaces": [
    "packages/*"
  ]
}
