# 密钥/凭证文件模板
# 复制为 .env 并填写实际值；.env 已被 .gitignore 排除，勿提交

# ── 易飞 OpenAPI 连接配置 ──
# 注意：token 等具体值请写入本地 .env 或 config/*.local.yaml（均不入库）
# 只填 IP 或 http://IP，路径 /YFOAP/.../ATNPost 由代码自动拼接
YF_BASE_URL=http://172.16.2.86
YF_COMPANY_ID=
YF_USER_TOKEN=

# ── 数据库（analysis 层直连，只读）──
# 密码只允许从环境变量取，配置文件中写变量名而非密码本身
YF_SQL_SERVER=
YF_SQL_PORT=1433
YF_SQL_DATABASE=
YF_SQL_USER_ENV=
YF_SQL_PASSWORD_ENV=

# ── License / 商业化（Phase 3）──
LICENSE_SERVER_URL=
LICENSE_PUBLIC_KEY=

