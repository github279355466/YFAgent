{
  "name": "yfcli-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "易飞(YF/E10) OpenAPI SDK —— 配置、封包、conditions 构造、响应解析与错误模型",
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:skeleton": "node tools/check-skeleton.mjs",
    "check:offline": "tsx tools/offline-verify.mjs",
    "check:eol": "node tools/normalize-eol.mjs --check",
    "check": "npm run check:skeleton && npm run typecheck && npm run check:offline && npm run check:eol"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
