{
  "name": "yfcli-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "易飞(YF/E10) MCP Server —— 集中式工具注册表 + HTTP/SSE 传输",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "yfcli-sdk": "*",
    "yfcli-auth": "*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "yaml": "^2.5.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  }
}
